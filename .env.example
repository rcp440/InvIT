# ===========================
# SERVIDOR
# ===========================
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# ===========================
# BASE DE DATOS PostgreSQL
# ===========================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=inventario_it
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_MAX_CONNECTIONS=20
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=2000
DB_SSL=false

# ===========================
# JWT
# ===========================
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_min_32_chars
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=your_refresh_secret_key_change_this_in_production_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# ===========================
# BCRYPT
# ===========================
BCRYPT_SALT_ROUNDS=12

# ===========================
# RATE LIMITING
# ===========================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10

# ===========================
# UPLOADS
# ===========================
UPLOAD_MAX_SIZE_MB=5
UPLOAD_PATH=./public/uploads

# ===========================
# LOGS
# ===========================
LOG_LEVEL=info
LOG_DIR=./logs

# ===========================
# CORS
# ===========================
CORS_ORIGIN=http://localhost:3000

# ===========================
# EMAIL / SMTP (opcional — necesario para reset de password)
# Si no se configura, el reset token se genera igual pero el email no se envía.
# ===========================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_cuenta@gmail.com
SMTP_PASS=tu_app_password
SMTP_FROM=InventarioIT <tu_cuenta@gmail.com>

# ===========================
# SUPERADMIN (usado solo al ejecutar npm run seed)
# En producción DEBE definirse; en desarrollo usa Admin@1234 si se omite.
# ===========================
SUPERADMIN_EMAIL=superadmin@inventarioit.com
SUPERADMIN_PASSWORD=change_this_before_running_seed

# ===========================
# DOCKER (solo para docker-compose)
# ===========================
APP_PORT=3000
DB_EXPOSE_PORT=5433
