# =============================================================================
# .env.production — InventarioIT SaaS
# Copiar a .env.production en el servidor y completar TODOS los valores.
# NUNCA commitear este archivo con valores reales.
# =============================================================================

# ── Servidor ──────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
APP_URL=http://192.0.1.5          # Cambiar por dominio o IP pública

# ── Base de datos (PostgreSQL local) ──────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=inventario_it
DB_USER=inventarioit_user          # Usuario dedicado — ver sección PostgreSQL abajo
DB_PASSWORD=CAMBIAR_PASSWORD_FUERTE
DB_SSL=false
DB_MAX_CONNECTIONS=20
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=2000

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=GENERAR_SECRETO_MINIMO_32_CHARS
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=GENERAR_OTRO_SECRETO_MINIMO_32_CHARS
JWT_REFRESH_EXPIRES_IN=7d

# ── Bcrypt ────────────────────────────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=12

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10

# ── Uploads ───────────────────────────────────────────────────────────────────
UPLOAD_MAX_SIZE_MB=5
UPLOAD_PATH=/opt/inventarioit/public/uploads

# ── Logs ──────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_DIR=/opt/inventarioit/logs

# ── CORS ──────────────────────────────────────────────────────────────────────
# Si Nginx está en el mismo server, solo localhost o el dominio real:
CORS_ORIGIN=http://192.0.1.5      # Cambiar por dominio si aplica

# ── Superadmin inicial (solo para npm run seed) ───────────────────────────────
SUPERADMIN_EMAIL=superadmin@inventarioit.com
SUPERADMIN_PASSWORD=CAMBIAR_PASSWORD_FUERTE_SUPERADMIN
